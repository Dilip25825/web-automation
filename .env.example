# Django production settings
SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=False
ALLOWED_HOSTS=web-automation-maar.onrender.com
CSRF_TRUSTED_ORIGINS=https://web-automation-maar.onrender.com
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=3600
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False

# Desktop licensing API
LICENSE_VALIDATION_API_KEY=replace-with-a-64-character-random-secret
ERP_API_IP_RATE_LIMIT=60
ERP_API_MOBILE_RATE_LIMIT=20

# Set only on the retired Render host while old Excel/VBA files use its URL.
# Example: https://your-replacement-domain.example (no trailing slash)
LEGACY_API_GATEWAY_BASE_URL=
LEGACY_API_GATEWAY_TIMEOUT_SECONDS=30

# Razorpay (enable only when live configuration is verified)
RAZORPAY_PAYMENT_LINKS_ENABLED=False
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Existing database and Google Drive variables remain required.
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_DRIVE_DOWNLOADS_FOLDER_ID=
GOOGLE_SERVICE_ACCOUNT_FILE=
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_DRIVE_DOWNLOADS_CACHE_SECONDS=300

# SMTP email service (fill with your domain mail provider details)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp-ddelwash.alwaysdata.net
EMAIL_PORT=465
EMAIL_USE_TLS=False
EMAIL_USE_SSL=True
EMAIL_HOST_USER=support@webautomationexcel.com
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=support@webautomationexcel.com
SERVER_EMAIL=support@webautomationexcel.com
EMAIL_TIMEOUT=30
